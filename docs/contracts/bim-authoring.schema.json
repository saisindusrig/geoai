        "intentHash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Intenthash",
          "type": "string"
        },
        "assets": {
          "items": {
            "$ref": "#/$defs/PlannedAsset"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Assets",
          "type": "array"
        },
        "assemblies": {
          "items": {
            "$ref": "#/$defs/PlannedAssembly"
          },
          "maxItems": 16,
          "minItems": 1,
