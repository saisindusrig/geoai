          "maxLength": 128,
          "minLength": 1,
          "title": "Componentid",
          "type": "string"
        },
        "parameterId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Parameterid",
          "type": "string"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
