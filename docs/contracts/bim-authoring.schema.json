        "profile": {
          "enum": [
            "RECTANGLE",
            "CIRCLE",
            "I",
            "CUSTOM"
          ],
          "title": "Profile",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "maxItems": 20,
          "title": "Parameters",
