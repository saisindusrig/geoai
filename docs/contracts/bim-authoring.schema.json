    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "sourceComponentId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sourcecomponentid",
          "type": "string"
        },
        "sourceParameterId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sourceparameterid",
          "type": "string"
        },
        "targetComponentId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Targetcomponentid",
          "type": "string"
        },
        "targetParameterId": {
          "maxLength": 128,
          "minLength": 1,
