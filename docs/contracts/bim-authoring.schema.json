          "type": "string"
        },
        "role": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "componentType": {
          "enum": [
            "BEAM",
            "GIRDER",
            "SLAB",
            "DECK",
            "COLUMN",
            "PIER",
            "WALL",
            "PILE",
            "PILE_CAP",
            "BEARING",
            "JOINT",
            "RAILING",
            "BARRIER",
            "BRACING",
            "PLATE",
            "CONNECTOR",
            "REINFORCEMENT"
          ],
          "title": "Componenttype",
          "type": "string"
