    "AuthoredComponent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "groupId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Groupid",
          "type": "string"
