    "Parameter": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "value": {
          "maximum": 2000,
          "minimum": -2000,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "enum": [
            "m",
            "deg",
            "count",
            "ratio"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "value",
        "unit"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "properties": {
        "coordinateFrame": {
          "const": "ASSEMBLY_LOCAL",
          "default": "ASSEMBLY_LOCAL",
          "title": "Coordinateframe",
          "type": "string"
        },
        "origin": {
          "default": [
            0,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "maximum": 2000,
              "minimum": -2000,
              "type": "number"
            },
            {
              "maximum": 2000,
              "minimum": -2000,
              "type": "number"
            },
            {
              "maximum": 2000,
              "minimum": -2000,
              "type": "number"
            }
          ],
          "title": "Origin",
          "type": "array"
        },
        "headingDeg": {
          "default": 0,
          "maximum": 360,
          "minimum": -360,
          "title": "Headingdeg",
          "type": "number"
        }
      },
      "title": "Placement",
      "type": "object"
    },
