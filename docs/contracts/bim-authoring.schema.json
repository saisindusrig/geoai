        "status": {
          "const": "UNRESOLVED",
          "default": "UNRESOLVED",
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fromComponentId",
        "kind",
        "explanation"
      ],
