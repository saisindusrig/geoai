    "Material": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category": {
          "enum": [
            "CONCRETE",
            "STEEL",
            "TIMBER",
            "ASPHALT",
            "OTHER",
            "UNKNOWN"
          ],
          "title": "Category",
          "type": "string"
        },
        "engineeringVerification": {
          "const": "UNVERIFIED",
          "default": "UNVERIFIED",
          "title": "Engineeringverification",
          "type": "string"
