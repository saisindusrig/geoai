        "role": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "componentType": {
          "enum": [
            "BEAM",
            "GIRDER",
            "SLAB",
            "DECK",
            "COLUMN",
            "PIER",
            "WALL",
            "PILE",
            "PILE_CAP",
            "BEARING",
            "JOINT",
            "RAILING",
            "BARRIER",
            "BRACING",
            "PLATE",
            "CONNECTOR",
            "REINFORCEMENT"
          ],
          "title": "Componenttype",
          "type": "string"
        },
        "materialId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Materialid",
          "type": "string"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "maxItems": 9,
          "minItems": 1,
          "title": "Parameters",
          "type": "array"
        },
        "crossSectionId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crosssectionid"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "recipe": {
          "$ref": "#/$defs/CADRecipe"
        }
      },
      "required": [
        "id",
        "groupId",
        "role",
        "componentType",
        "materialId",
        "parameters",
        "recipe"
      ],
      "title": "AuthoredComponent",
      "type": "object"
    },
    "AuthoringIntent": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "bim-authoring-intent/1",
          "default": "bim-authoring-intent/1",
          "title": "Schemaversion",
          "type": "string"
        },
        "requestedStructure": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Requestedstructure",
          "type": "string"
        },
        "systems": {
          "items": {
            "$ref": "#/$defs/SystemRequest"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Systems",
          "type": "array"
        },
        "requestedFeatures": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Requestedfeatures",
          "type": "array"
        },
        "requestedSelectionRef": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requestedselectionref"
        },
        "requestedObjectRefs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "title": "Requestedobjectrefs",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Assumptions",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "$ref": "#/$defs/UnknownCondition"
          },
          "maxItems": 30,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "requestedStructure",
        "systems"
      ],
      "title": "AuthoringIntent",
      "type": "object"
    },
    "CADRecipe": {
      "additionalProperties": false,
      "properties": {
        "componentId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Componentid",
          "type": "string"
        },
        "operation": {
          "enum": [
            "PROFILE_EXTRUSION",
            "CIRCULAR_COLUMN",
            "RECTANGULAR_OPENING",
            "CIRCULAR_HOLE",
            "RECTANGULAR_LOFT"
