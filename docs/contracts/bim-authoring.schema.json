      "type": "object"
    },
    "ClearanceIntent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "componentIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Componentids",
          "type": "array"
        },
        "status": {
          "const": "UNRESOLVED",
          "default": "UNRESOLVED",
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "componentIds",
        "explanation"
      ],
      "title": "ClearanceIntent",
      "type": "object"
    },
    "ConnectionIntent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "fromComponentId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Fromcomponentid",
          "type": "string"
        },
        "toComponentId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tocomponentid"
        },
        "externalSupport": {
          "anyOf": [
            {
              "const": "UNKNOWN_FOUNDATION",
