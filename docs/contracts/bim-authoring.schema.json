          "type": "array"
        },
        "materials": {
          "items": {
            "$ref": "#/$defs/Material"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Materials",
          "type": "array"
        },
        "crossSections": {
          "items": {
            "$ref": "#/$defs/CrossSection"
          },
          "maxItems": 30,
          "title": "Crosssections",
          "type": "array"
