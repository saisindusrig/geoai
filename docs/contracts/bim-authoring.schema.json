      "title": "AssemblyExpansion",
      "type": "object"
    },
    "AssemblyPlan": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "bim-assembly-plan/1",
          "default": "bim-assembly-plan/1",
