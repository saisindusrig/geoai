      },
      "required": [
        "intentHash",
        "assets",
        "assemblies",
        "materials"
      ],
      "title": "AssemblyPlan",
      "type": "object"
    },
    "AssemblyRelationships": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "bim-assembly-relationships/1",
          "default": "bim-assembly-relationships/1",
          "title": "Schemaversion",
          "type": "string"
        },
        "planHash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Planhash",
          "type": "string"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/ConnectionIntent"
          },
          "maxItems": 128,
          "title": "Connections",
          "type": "array"
        },
        "clearances": {
          "items": {
            "$ref": "#/$defs/ClearanceIntent"
          },
          "maxItems": 64,
          "title": "Clearances",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "maxItems": 128,
          "title": "Dependencies",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "maxItems": 128,
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": [
        "planHash",
        "connections",
        "clearances"
      ],
